{
  "name": "novel-forge",
  "displayName": "Novel Forge — 长篇小说上下文管理",
  "description": "为长篇小说写作提供上下文注入、纲要扩写与角色/剧情整合总结的 VS Code 插件。",
  "version": "0.1.0",
  "publisher": "novel-forge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "novel",
    "writing",
    "llm",
    "context",
    "小说"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.novelforge/project.json",
    "workspaceContains:.novel/project.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelForge",
          "title": "Novel Forge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "novelForge": [
        {
          "id": "novelForge.chat",
          "name": "对话",
          "type": "webview"
        },
        {
          "id": "novelForge.explorer",
          "name": "小说工程",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "novelForge.explorer",
        "contents": "当前工作区还不是 Novel Forge 小说工程。\n[初始化小说工程](command:novel.initProject)\n初始化会创建 chapters/ 与 .novelforge/ 目录及模板文件。"
      }
    ],
    "commands": [
      {
        "command": "novel.initProject",
        "title": "Novel: 初始化小说工程",
        "icon": "$(new-folder)"
      },
      {
        "command": "novel.refresh",
        "title": "Novel: 刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "novel.newChapter",
        "title": "Novel: 新建章节",
        "icon": "$(add)"
      },
      {
        "command": "novel.setApiKey",
        "title": "Novel: 设置 API Key"
      },
      {
        "command": "novel.clearApiKey",
        "title": "Novel: 清除 API Key"
      },
      {
        "command": "novel.selectModel",
        "title": "Novel: 选择模型"
      },
      {
        "command": "novel.continue",
        "title": "Novel: 打开续写对话",
        "icon": "$(sparkle)"
      },
      {
        "command": "novel.openChatInEditor",
        "title": "Novel: 在编辑器中打开对话面板",
        "icon": "$(link-external)"
      },
      {
        "command": "novel.newSession",
        "title": "Novel: 新建对话",
        "icon": "$(add)"
      },
      {
        "command": "novel.addSelectionToChat",
        "title": "Novel: 将选中文本加入对话上下文"
      },
      {
        "command": "novel.openSettings",
        "title": "Novel: 打开设置页",
        "icon": "$(gear)"
      },
      {
        "command": "novel.continueFromChapter",
        "title": "在此续写",
        "icon": "$(sparkle)"
      },
      {
        "command": "novel.quickContinue",
        "title": "Novel: 快速续写（不开面板）"
      },
      {
        "command": "novel.summarizeChapter",
        "title": "Novel: 总结本章",
        "icon": "$(book)"
      },
      {
        "command": "novel.syncSummaries",
        "title": "Novel: 同步所有过期摘要"
      },
      {
        "command": "novel.rebuildGlobalSummary",
        "title": "Novel: 重建全书摘要"
      },
      {
        "command": "novel.extractCharacters",
        "title": "Novel: 提取/更新角色卡"
      },
      {
        "command": "novel.extractStyle",
        "title": "Novel: 提取文风指南"
      },
      {
        "command": "novel.openFile",
        "title": "打开文件"
      },
      {
        "command": "novel.newCharacter",
        "title": "Novel: 新建角色卡",
        "icon": "$(person-add)"
      },
      {
        "command": "novel.newLore",
        "title": "Novel: 新建设定条目",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novel.newSession",
          "when": "view == novelForge.chat",
          "group": "navigation@1"
        },
        {
          "command": "novel.openChatInEditor",
          "when": "view == novelForge.chat",
          "group": "navigation@2"
        },
        {
          "command": "novel.continue",
          "when": "view == novelForge.explorer",
          "group": "navigation@1"
        },
        {
          "command": "novel.newChapter",
          "when": "view == novelForge.explorer",
          "group": "navigation@2"
        },
        {
          "command": "novel.refresh",
          "when": "view == novelForge.explorer",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "novel.addSelectionToChat",
          "when": "editorHasSelection && novelForge.initialized",
          "group": "novelforge@1"
        }
      ],
      "view/item/context": [
        {
          "command": "novel.continueFromChapter",
          "when": "view == novelForge.explorer && viewItem == chapter",
          "group": "inline@1"
        },
        {
          "command": "novel.summarizeChapter",
          "when": "view == novelForge.explorer && viewItem == chapter",
          "group": "inline@2"
        },
        {
          "command": "novel.newChapter",
          "when": "view == novelForge.explorer && viewItem == group:chapters",
          "group": "inline"
        },
        {
          "command": "novel.newCharacter",
          "when": "view == novelForge.explorer && viewItem == group:characters",
          "group": "inline"
        },
        {
          "command": "novel.newLore",
          "when": "view == novelForge.explorer && viewItem == group:lore",
          "group": "inline"
        },
        {
          "command": "novel.syncSummaries",
          "when": "view == novelForge.explorer && viewItem == group:summaries",
          "group": "1_novel"
        },
        {
          "command": "novel.rebuildGlobalSummary",
          "when": "view == novelForge.explorer && viewItem == group:summaries",
          "group": "1_novel"
        }
      ]
    },
    "keybindings": [
      {
        "command": "novel.addSelectionToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorHasSelection && novelForge.initialized"
      }
    ],
    "configuration": {
      "title": "Novel Forge",
      "properties": {
        "novel.providers": {
          "type": "array",
          "default": [],
          "markdownDescription": "服务商列表。每个服务商有一个前缀 `id`，其下可配置多个模型；模型用 `前缀/模型名` 引用（模型名本身可含斜杠，只在第一个斜杠处切分）。留空时会沿用旧版的 `novel.provider` 等设置。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "models"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "description": "引用前缀，不能含斜杠。例如 glm、openrouter、ollama。"
              },
              "label": {
                "type": "string",
                "description": "显示名，留空则显示 id。"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic",
                  "vscode-lm"
                ],
                "default": "openai",
                "enumDescriptions": [
                  "OpenAI 兼容接口（OpenAI / DeepSeek / 智谱 / Kimi / 通义 / OpenRouter / Ollama 等）",
                  "Anthropic Messages API",
                  "VS Code Language Model API（复用 GitHub Copilot 订阅）"
                ],
                "description": "接口协议。"
              },
              "baseUrl": {
                "type": "string",
                "description": "接口地址，不含末尾斜杠。vscode-lm 无需填写。"
              },
              "models": {
                "type": "array",
                "description": "该服务商下的模型清单。",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "原样传给 API 的模型名，可含斜杠，如 z-ai/glm-4.6。"
                    },
                    "label": {
                      "type": "string",
                      "description": "显示名，留空则显示模型名。"
                    },
                    "contextWindow": {
                      "type": "number",
                      "description": "该模型的上下文窗口，留空则用 novel.contextWindow。"
                    },
                    "maxOutputTokens": {
                      "type": "number",
                      "description": "该模型的最大输出 token，留空则用 novel.maxOutputTokens。"
                    }
                  }
                }
              }
            }
          }
        },
        "novel.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "当前使用的模型，格式为 `前缀/模型名`，例如 `glm/glm-4-plus`、`openrouter/z-ai/glm-4.6`。留空则取第一个可用模型。"
        },
        "novel.contextWindow": {
          "type": "number",
          "default": 128000,
          "minimum": 4000,
          "description": "默认上下文窗口大小（token）。模型自带 contextWindow 时以模型为准。"
        },
        "novel.maxOutputTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 256,
          "description": "默认单次生成的最大输出 token 数。模型自带 maxOutputTokens 时以模型为准。"
        },
        "novel.temperature": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 2,
          "description": "采样温度。写小说建议 0.7 ~ 1.0。摘要类任务内部固定用 0.3。"
        },
        "novel.recentChaptersFullText": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "续写时注入多少章「完整原文」（不含上一章结尾片段）。预算不足会自动降级为摘要。"
        },
        "novel.prevChapterTailChars": {
          "type": "number",
          "default": 1500,
          "minimum": 0,
          "description": "上一章结尾原文注入的字数，用于保证语气衔接。"
        },
        "novel.chaptersDir": {
          "type": "string",
          "default": "chapters",
          "description": "章节正文目录（相对工作区根目录）。"
        },
        "novel.summaryBatchSize": {
          "type": "number",
          "default": 15,
          "minimum": 3,
          "description": "重建全书摘要时，每批 reduce 多少章的单章摘要。"
        },
        "novel.requestTimeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 10000,
          "description": "单次 LLM 请求超时（毫秒）。"
        },
        "novel.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "vscode-lm"
          ],
          "default": "openai",
          "markdownDeprecationMessage": "已由 `novel.providers` + `novel.model` 取代。仅在 `novel.providers` 为空时作为兼容兜底。",
          "description": "（旧版）使用哪个大模型服务商。"
        },
        "novel.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "markdownDeprecationMessage": "已由 `novel.providers` 中各服务商的 `baseUrl` 取代。",
          "description": "（旧版）OpenAI 兼容接口的 baseUrl。"
        },
        "novel.openai.model": {
          "type": "string",
          "default": "gpt-4o",
          "markdownDeprecationMessage": "已由 `novel.providers` 中的模型清单取代。",
          "description": "（旧版）OpenAI 兼容接口使用的模型名。"
        },
        "novel.anthropic.baseUrl": {
          "type": "string",
          "default": "https://api.anthropic.com",
          "markdownDeprecationMessage": "已由 `novel.providers` 中各服务商的 `baseUrl` 取代。",
          "description": "（旧版）Anthropic API baseUrl。"
        },
        "novel.anthropic.model": {
          "type": "string",
          "default": "claude-sonnet-4-5",
          "markdownDeprecationMessage": "已由 `novel.providers` 中的模型清单取代。",
          "description": "（旧版）Anthropic 使用的模型名。"
        },
        "novel.vscodeLm.family": {
          "type": "string",
          "default": "gpt-4o",
          "markdownDeprecationMessage": "已由 `novel.providers` 中 kind 为 vscode-lm 的服务商取代。",
          "description": "（旧版）VS Code LM API 选择的模型 family。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.js && node scripts/smoke-providers.js && node scripts/smoke-builder.js && node scripts/smoke-llm.js && node scripts/smoke-session.js",
    "test": "npm run typecheck && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
