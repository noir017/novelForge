node_modules/
# 全部构建产物都在这里：dist/extension.js、dist/media/（前端，源码在 media/src/）、
# dist/novelforge（单文件可执行）。一处都不入库。
dist/
out/
*.vsix
.DS_Store

src/standalone/mediaAssets.ts
sample-novel/.novelforge/sessions

# 工程数据库（失败记录 + 日志历史）。它是可丢弃的痕迹，不是内容——
# 内容一律是 Markdown。WAL 模式还会带出 -wal / -shm 两个附属文件。
*.db
*.db-wal
*.db-shm

.claude/
temp/
local/

# git worktree 隔离目录（见 .worktrees/）
.worktrees/

# 桌面壳的构建产物：sidecar 可执行文件（由 scripts/build-sidecar.js 生成，
# 与 dist/novelforge 同源）与 Rust 编译中间产物。壳的源码本身是入库的。
src-tauri/binaries/
src-tauri/target/