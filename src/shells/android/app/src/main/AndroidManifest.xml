<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 本机模式：写一章要几分钟，切到后台时系统会冻住 app 连同内置的 node；前台服务（常驻通知）让它接着跑 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 书放在 Documents/NovelForge：别的 app（文件管理、同步盘）也看得到。内置服务端是 node，只认文件路径、
         不认 content:// 那一套，所以 Android 11+ 要「所有文件访问」，10 及以下要写存储权限。不给就放在 app 自己的目录 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- usesCleartextTraffic：内置服务端走 http://127.0.0.1，远程模式也允许局域网 http 服务端。
         requestLegacyExternalStorage：Android 10 上没有「所有文件访问」，靠它按路径读写公共目录 -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- configChanges：旋转、深色模式切换等不重建 Activity，页面与编辑中的内容原样保留 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="本机写作服务：生成章节期间保持内置服务端运行" />
        </service>
    </application>
</manifest>
